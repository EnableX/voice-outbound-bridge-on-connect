# EnableX API Credentials
# Get these from https://portal.enablex.io/
ENABLEX_APP_ID=
ENABLEX_APP_KEY=

# Port this service will listen on
SERVICE_PORT=3000

# Public URL for EnableX to send webhook events
# Use ngrok for local testing: ./ngrok http 3000
# Example: https://abc123.ngrok.io
PUBLIC_WEBHOOK_URL=

# Run server over HTTP or HTTPS
# Set to 'false' for plain HTTP (local dev / behind a TLS-terminating proxy)
LISTEN_SSL=false

# SSL certificate paths (required only when LISTEN_SSL is not 'false')
CERTIFICATE_SSL_KEY=./certs/example.key
CERTIFICATE_SSL_CERT=./certs/example.crt
CERTIFICATE_SSL_CACERTS=./certs/example.ca-bundle
